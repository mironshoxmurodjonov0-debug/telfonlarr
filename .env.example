# GEMINI_API_KEY: Optional Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API token (keep secret in server environment / AI Studio Secrets).
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHANNEL_ID: Target Telegram channel ID for real-time order notifications.
TELEGRAM_CHANNEL_ID=-1003957660682

# ADMIN_PASSCODE: Admin panel login passcode (optional; if unset, first-run claim sets password).
ADMIN_PASSCODE=
